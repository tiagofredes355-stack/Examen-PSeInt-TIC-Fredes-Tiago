Algoritmo ejercicio_5
	//Simulación de Conteo Regresivo Ingresar un número inicial N. 
	//Realizar un conteo regresivo desde N hasta 0 
	//usando la estructura Para con paso -1.
	//Al llegar a 0, imprimir "¡Despegue!".
	definir N,suma,tiempo como entero;
	para i=0 hasta paso -1 Hacer
		escribir"inicia el conteo";
		leer suma;
		suma=suma+1;
	FinPara
	escribir "!despegue¡";
FinAlgoritmo
